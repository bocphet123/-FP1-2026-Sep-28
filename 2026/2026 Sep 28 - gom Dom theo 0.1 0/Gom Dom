    const widgetEl = document.getElementById('fp1-widget');
    const headerEl = document.getElementById('fp1-header');
    const domTableEl = document.getElementById('fp1-dom-table');
    const domHeaderEl = document.getElementById('fp1-dom-header');
    const fpTableEl = document.getElementById('fp1-fp-table');
    const cvdPanelEl = document.getElementById('fp1-cvd-panel');
    const multiDayTableEl = document.getElementById('fp1-multiday-table');
    const multiDayPanelEl = document.getElementById('fp1-multiday-panel');
    const toggleCvdBtn = document.getElementById('fp1-toggle-cvd');
    const toggleHistBtn = document.getElementById('fp1-toggle-history');
    const toggleGroupingBtn = document.getElementById('fp1-toggle-grouping');
    const blockFilterSelect = document.getElementById('fp1-block-filter');
    const bodyContainerEl = document.getElementById('fp1-body-container');
    const totalEl = document.getElementById('fp1-total');
    const statusEl = document.getElementById('fp1-status');
    const hbEl = document.getElementById('fp1-heartbeat');
    const alertBannerEl = document.getElementById('fp1-alert-banner');
    const cvdValEl = document.getElementById('fp1-cvd-val');
    const cvdCanvas = document.getElementById('fp1-cvd-canvas');
    const ctxCVD = cvdCanvas ? cvdCanvas.getContext('2d') : null;

    document.querySelectorAll('.fp1-tf-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.fp1-tf-btn').forEach(b => b.classList.remove('active-tf'));
            e.target.classList.add('active-tf');
            selectedCvdTf = e.target.getAttribute('data-tf');
            renderWidget();
        });
    });

    let isDragging = false;
    let startX, startY, initialLeft, initialTop;

    headerEl.addEventListener('mousedown', (e) => {
        if (e.target.tagName === 'BUTTON' || e.target.tagName === 'SELECT') return;
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = widgetEl.getBoundingClientRect();
        widgetEl.style.right = 'auto';
        widgetEl.style.left = rect.left + 'px';
        widgetEl.style.top = rect.top + 'px';
        initialLeft = rect.left;
        initialTop = rect.top;
        e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        widgetEl.style.left = (initialLeft + (e.clientX - startX)) + 'px';
        widgetEl.style.top = (initialTop + (e.clientY - startY)) + 'px';
    });

    document.addEventListener('mouseup', () => { isDragging = false; });

    blockFilterSelect.addEventListener('change', (e) => {
        blockTradeThreshold = parseInt(e.target.value) || 0;
        renderWidget();
    });

    // Bắt sự kiện Toggle Grouping DOM (0.1 -> 0.5 -> 1.0 -> 0.1)
    toggleGroupingBtn.addEventListener('click', () => {
        if (domGroupingStep === 0.1) domGroupingStep = 0.5;
        else if (domGroupingStep === 0.5) domGroupingStep = 1.0;
        else domGroupingStep = 0.1;

        toggleGroupingBtn.innerText = `Gom: ${domGroupingStep.toFixed(1)}`;
        if (domHeaderEl) domHeaderEl.innerText = `📈 DOM (Chi tiết ${domGroupingStep.toFixed(1)})`;
        renderWidget();
    });

    function updateWidgetLayout() {
        if (showCvdPanel) { cvdPanelEl.style.display = 'flex'; toggleCvdBtn.classList.add('active-cvd'); } else { cvdPanelEl.style.display = 'none'; toggleCvdBtn.classList.remove('active-cvd'); }
        if (showHistoryPanel) { multiDayPanelEl.style.display = 'flex'; toggleHistBtn.classList.add('active-hist'); } else { multiDayPanelEl.style.display = 'none'; toggleHistBtn.classList.remove('active-hist'); }
        let visiblePanels = 2 + (showCvdPanel ? 1 : 0) + (showHistoryPanel ? 1 : 0);
        if (visiblePanels === 4) { widgetEl.style.width = '1150px'; widgetEl.style.minWidth = '850px'; }
        else if (visiblePanels === 3) { widgetEl.style.width = '900px'; widgetEl.style.minWidth = '680px'; }
        else if (visiblePanels === 2) { widgetEl.style.width = '680px'; widgetEl.style.minWidth = '500px'; }
    }

    toggleCvdBtn.addEventListener('click', () => { showCvdPanel = !showCvdPanel; updateWidgetLayout(); renderWidget(); });
    toggleHistBtn.addEventListener('click', () => { showHistoryPanel = !showHistoryPanel; updateWidgetLayout(); renderWidget(); });

    document.getElementById('fp1-reset').addEventListener('click', () => {
        if (confirm('Xóa dữ liệu tích lũy của riêng ngày hôm nay?')) {
            priceProfile = {}; totalVolAccumulated = 0; cvdHistory = []; tradesLog = []; currentTradedPriceInt = null; processedSignatures.clear(); saveData(); renderWidget();
        }
    });

    document.getElementById('fp1-reset-multi').addEventListener('click', () => {
        if (confirm('Xóa toàn bộ lịch sử tích lũy đa phiên từ trước đến nay?')) {
            multiDayData = { sessions: {} }; priceProfile = {}; totalVolAccumulated = 0; cvdHistory = []; tradesLog = []; GM_setValue(MULTI_DAY_STORAGE_KEY, multiDayData); saveData(); renderWidget();
        }
    });

    document.getElementById('fp1-toggle-size').addEventListener('click', () => {
        isMinimized = !isMinimized;
        bodyContainerEl.style.display = isMinimized ? 'none' : 'flex';
        document.getElementById('fp1-toggle-size').innerText = isMinimized ? '+' : '_';
    });

    function saveData() {
        GM_setValue(DAILY_STORAGE_KEY, { date: todayStr, profile: priceProfile, totalVol: totalVolAccumulated, cvdData: cvdHistory.slice(-1000), tradesLog: tradesLog.slice(-300) });
        multiDayData.sessions[todayStr] = JSON.parse(JSON.stringify(priceProfile));
        GM_setValue(MULTI_DAY_STORAGE_KEY, multiDayData);
    }

    function scanMarketDepthDOM() {
        let depthPanel = null;
        const allDivs = document.querySelectorAll('div');
        for (let div of allDivs) {
            if (div.innerText && div.innerText.includes('Độ sâu thị trường')) { depthPanel = div; break; }
        }
        if (!depthPanel) return;

        let newBook = {};
        const rows = depthPanel.querySelectorAll('div, tr');

        rows.forEach(row => {
            let text = row.innerText ? row.innerText.trim() : '';
            let parts = text.split(/\s+/);

            for (let i = 0; i < parts.length; i++) {
                let pVal = parseFloat(parts[i].replace(/,/g, ''));
                if (!isNaN(pVal) && pVal > 1000 && pVal < 2500 && parts[i].includes('.')) {
                    let priceStr = pVal.toFixed(1);

                    if (!newBook[priceStr]) {
                        newBook[priceStr] = { bidVol: 0, askVol: 0 };
                    }

                    if (i > 0 && !parts[i-1].includes('.')) {
                        let bidVol = parseInt(parts[i-1].replace(/,/g, ''));
                        if (!isNaN(bidVol) && bidVol > 0) {
                            newBook[priceStr].bidVol = Math.max(newBook[priceStr].bidVol, bidVol);
                        }
                    }

                    if (i < parts.length - 1 && !parts[i+1].includes('.')) {
                        let askVol = parseInt(parts[i+1].replace(/,/g, ''));
                        if (!isNaN(askVol) && askVol > 0) {
                            newBook[priceStr].askVol = Math.max(newBook[priceStr].askVol, askVol);
                        }
                    }
                }
            }
        });

        if (Object.keys(newBook).length > 0) {
            liveOrderBook = newBook;
            analyzeDOMDelta(newBook);
            renderWidget();
        }
    }

    function analyzeDOMDelta(newBook) {
        if (Object.keys(prevOrderBook).length === 0) {
            prevOrderBook = JSON.parse(JSON.stringify(newBook));
            return;
        }

        let currentPriceVal = currentTradedPriceInt ? parseFloat(currentTradedPriceInt) : null;
        let eventDetected = null;
        let allPrices = new Set([...Object.keys(newBook), ...Object.keys(prevOrderBook)]);

        allPrices.forEach(priceStr => {
            let priceNum = parseFloat(priceStr);
            if (!currentPriceVal || Math.abs(priceNum - currentPriceVal) <= 3.0) {
                let curr = newBook[priceStr] || { bidVol: 0, askVol: 0 };
                let prev = prevOrderBook[priceStr] || { bidVol: 0, askVol: 0 };
                let tradedBid = tradesSinceLastDOM.bidTraded[priceStr] || 0;
                let tradedAsk = tradesSinceLastDOM.askTraded[priceStr] || 0;

                let expectedBid = prev.bidVol - tradedBid;
                let bidRefill = curr.bidVol - expectedBid;
                let bidCancel = expectedBid - curr.bidVol;

                if (tradedBid > 0 && bidRefill >= 20) {
                    eventDetected = { type: 'iceberg', text: `🧊 <b>ICEBERG BUY:</b> Cầu ẩn tự sạc thêm +${bidRefill} lô Mua tại ${priceStr}`, class: 'iceberg-alert' };
                } else if (tradedBid === 0 && bidCancel >= 50 && prev.bidVol >= 50) {
                    eventDetected = { type: 'spoof', text: `💨 <b>SPOOF CANCEL:</b> Rút cục kê Mua lớn -${bidCancel} lô tại ${priceStr}`, class: 'spoof-alert' };
                } else if (tradedBid === 0 && bidRefill >= 50) {
                    eventDetected = { type: 'stack', text: `🧱 <b>SPOOF ADD:</b> Kê thêm +${bidRefill} lô Mua tại ${priceStr}`, class: 'buy-alert' };
                }

                let expectedAsk = prev.askVol - tradedAsk;
                let askRefill = curr.askVol - expectedAsk;
                let askCancel = expectedAsk - curr.askVol;

                if (tradedAsk > 0 && askRefill >= 20) {
                    eventDetected = { type: 'iceberg', text: `🧊 <b>ICEBERG SELL:</b> Cung ẩn tự sạc thêm +${askRefill} lô Bán tại ${priceStr}`, class: 'iceberg-alert' };
                } else if (tradedAsk === 0 && askCancel >= 50 && prev.askVol >= 50) {
                    eventDetected = { type: 'spoof', text: `💨 <b>SPOOF CANCEL:</b> Rút cục kê Bán lớn -${askCancel} lô tại ${priceStr}`, class: 'spoof-alert' };
                } else if (tradedAsk === 0 && askRefill >= 50) {
                    eventDetected = { type: 'stack', text: `🧱 <b>SPOOF ADD:</b> Kê thêm +${askRefill} lô Bán tại ${priceStr}`, class: 'sell-alert' };
                }
            }
        });

        prevOrderBook = JSON.parse(JSON.stringify(newBook));
        tradesSinceLastDOM = { bidTraded: {}, askTraded: {} };

        if (eventDetected) {
            alertBannerEl.className = eventDetected.class;
            alertBannerEl.innerHTML = eventDetected.text;
            alertBannerEl.style.display = 'flex';
        }
    }

    function checkDivergence(filteredData) {
        if (filteredData.length < 20) return null;
        let now = Date.now();
        if (now - lastDivergenceCheckTime < 10000) return null;

        let mid = Math.floor(filteredData.length / 2);
        let firstHalf = filteredData.slice(0, mid);
        let secondHalf = filteredData.slice(mid);

        let p1Max = Math.max(...firstHalf.map(d => d.price));
        let p2Max = Math.max(...secondHalf.map(d => d.price));
        let c1Max = Math.max(...firstHalf.map(d => d.cvd));
        let c2Max = Math.max(...secondHalf.map(d => d.cvd));

        let p1Min = Math.min(...firstHalf.map(d => d.price));
        let p2Min = Math.min(...secondHalf.map(d => d.price));
        let c1Min = Math.min(...firstHalf.map(d => d.cvd));
        let c2Min = Math.min(...secondHalf.map(d => d.cvd));

        if (p2Max > p1Max && c2Max < c1Max) {
            lastDivergenceCheckTime = now;
            return { type: 'bear', text: `⚠️ <b>PHÂN KỲ ÂM (Bearish):</b> Giá tăng nhưng Dòng tiền (CVD) suy yếu!` };
        }

        if (p2Min <= p1Min && c2Min > c1Min) {
            lastDivergenceCheckTime = now;
            return { type: 'bull', text: `💡 <b>PHÂN KỲ DƯƠNG (Bullish):</b> Giá chững/giảm nhưng Dòng tiền (CVD) hấp thụ mạnh!` };
        }

        return null;
    }

    function getFilteredCVDData() {
        if (cvdHistory.length === 0) return [];
        if (selectedCvdTf === 'all') return cvdHistory;

        let tfMinutes = 5;
        if (selectedCvdTf === '10m') tfMinutes = 10;
        else if (selectedCvdTf === '15m') tfMinutes = 15;
        else if (selectedCvdTf === '30m') tfMinutes = 30;
        else if (selectedCvdTf === '45m') tfMinutes = 45;
        else if (selectedCvdTf === '1h') tfMinutes = 60;
        else if (selectedCvdTf === '1d') tfMinutes = 1440;

        let cutoffTime = Date.now() - (tfMinutes * 60 * 1000);
        let filtered = cvdHistory.filter(item => item.time >= cutoffTime);
        return filtered.length > 0 ? filtered : cvdHistory;
    }

    function drawCVDChart() {
        let currentCVD = cvdHistory.length > 0 ? cvdHistory[cvdHistory.length - 1].cvd : 0;
        if (cvdValEl) {
            cvdValEl.innerText = `CVD: ${currentCVD > 0 ? '+' : ''}${currentCVD.toLocaleString()}`;
            cvdValEl.style.color = currentCVD >= 0 ? '#089981' : '#f23645';
        }

        if (!showCvdPanel || !ctxCVD || !cvdCanvas) return;
        const width = cvdCanvas.width = cvdCanvas.parentElement.clientWidth;
        const height = cvdCanvas.height = cvdCanvas.parentElement.clientHeight || 150;
        ctxCVD.clearRect(0, 0, width, height);

        let activeData = getFilteredCVDData();
        if (activeData.length === 0) {
            ctxCVD.fillStyle = '#787b86'; ctxCVD.font = '10px sans-serif'; ctxCVD.textAlign = 'center';
            ctxCVD.fillText('Chờ dữ liệu CVD...', width / 2, height / 2);
            return;
        }

        let divAlert = checkDivergence(activeData);
        if (divAlert) {
            alertBannerEl.className = divAlert.type === 'bull' ? 'divergence-bull' : 'divergence-bear';
            alertBannerEl.innerHTML = divAlert.text;
            alertBannerEl.style.display = 'flex';
        }

        let minCVD = 0, maxCVD = 0, minPrice = Infinity, maxPrice = -Infinity;
        activeData.forEach(item => {
            if (item.cvd < minCVD) minCVD = item.cvd;
            if (item.cvd > maxCVD) maxCVD = item.cvd;
            if (item.price < minPrice) minPrice = item.price;
            if (item.price > maxPrice) maxPrice = item.price;
        });
        if (maxCVD === minCVD) { maxCVD += 10; minCVD -= 10; }
        if (maxPrice === minPrice) { maxPrice += 1; minPrice -= 1; }

        let padding = 18;
        let graphHeight = height - padding * 2;
        let zeroY = height - padding - ((0 - minCVD) / (maxCVD - minCVD)) * graphHeight;

        ctxCVD.strokeStyle = '#363c4e'; ctxCVD.lineWidth = 1; ctxCVD.setLineDash([2, 2]);
        ctxCVD.beginPath(); ctxCVD.moveTo(0, zeroY); ctxCVD.lineTo(width, zeroY); ctxCVD.stroke(); ctxCVD.setLineDash([]);

        let stepX = width / Math.max(activeData.length - 1, 1);

        ctxCVD.beginPath(); ctxCVD.lineWidth = 1.5;
        activeData.forEach((item, index) => {
            let x = index * stepX;
            let y = height - padding - ((item.price - minPrice) / (maxPrice - minPrice)) * graphHeight;
            if (index === 0) ctxCVD.moveTo(x, y); else ctxCVD.lineTo(x, y);
        });
        ctxCVD.strokeStyle = 'rgba(255, 152, 0, 0.7)';
        ctxCVD.stroke();

        ctxCVD.beginPath(); ctxCVD.lineWidth = 2;
        activeData.forEach((item, index) => {
            let x = index * stepX;
            let y = height - padding - ((item.cvd - minCVD) / (maxCVD - minCVD)) * graphHeight;
            if (index === 0) ctxCVD.moveTo(x, y); else ctxCVD.lineTo(x, y);
        });
        ctxCVD.strokeStyle = currentCVD >= 0 ? '#089981' : '#f23645';
        ctxCVD.stroke();
    }

    function renderWidget() {
        // Thuật toán gom nhóm (Grouping) các mức giá DOM theo domGroupingStep (0.1, 0.5, 1.0)
        let groupedOrderBook = {};
        if (domGroupingStep === 0.1) {
            groupedOrderBook = liveOrderBook;
        } else {
            Object.keys(liveOrderBook).forEach(priceStr => {
                let pNum = parseFloat(priceStr);
                if (isNaN(pNum)) return;
                let stepUnits = Math.round(domGroupingStep * 10);
                let priceUnits = Math.round(pNum * 10);
                let bucketUnits = Math.floor(priceUnits / stepUnits) * stepUnits;
                let bucketStr = (bucketUnits / 10).toFixed(1);

                if (!groupedOrderBook[bucketStr]) groupedOrderBook[bucketStr] = { bidVol: 0, askVol: 0 };
                groupedOrderBook[bucketStr].bidVol += (liveOrderBook[priceStr].bidVol || 0);
                groupedOrderBook[bucketStr].askVol += (liveOrderBook[priceStr].askVol || 0);
            });
        }

        let domPricesSet = new Set(Object.keys(groupedOrderBook));
        if (domPricesSet.size === 0 && currentTradedPriceInt) {
            let base = parseFloat(currentTradedPriceInt);
            for (let i = 4; i >= -4; i--) domPricesSet.add((base + i * domGroupingStep).toFixed(1));
        }
        let sortedDomPrices = Array.from(domPricesSet).sort((a, b) => parseFloat(b) - parseFloat(a));
        let maxBid = 1, maxAsk = 1;
        Object.values(groupedOrderBook).forEach(item => { if (item.bidVol > maxBid) maxBid = item.bidVol; if (item.askVol > maxAsk) maxAsk = item.askVol; });

        let domHtml = `<thead><tr><th class="left">Mua</th><th class="center">Giá</th><th class="right">Bán</th></tr></thead><tbody>`;
        if (sortedDomPrices.length === 0) {
            domHtml += `<tr><td colspan="3" style="text-align: center; color: #787b86; padding: 20px;">Đang kết nối DOM...</td></tr>`;
        } else {
            sortedDomPrices.forEach(priceStr => {
                let bookItem = groupedOrderBook[priceStr] || { bidVol: 0, askVol: 0 };
                let bidW = maxBid > 0 ? (bookItem.bidVol / maxBid) * 100 : 0;
                let askW = maxAsk > 0 ? (bookItem.askVol / maxAsk) * 100 : 0;

                let priceNum = parseFloat(priceStr);
                let isCurrent = false;
                if (currentTradedPriceInt) {
                    let cNum = parseFloat(currentTradedPriceInt);
                    if (domGroupingStep === 0.1) {
                        isCurrent = Math.abs(priceNum - cNum) < 0.05;
                    } else {
                        isCurrent = (cNum >= priceNum && cNum < priceNum + domGroupingStep);
                    }
                }
                let indicatorHtml = isCurrent ? `<span class="fp1-current-indicator">▶</span>` : '';

                domHtml += `
                    <tr class="fp1-row-item">
                        <td class="fp1-bid-cell"><div class="fp1-bar-bid" style="width: ${bidW}%;"></div><span class="fp1-cell-text">${bookItem.bidVol > 0 ? bookItem.bidVol.toLocaleString() : ''}</span></td>
                        <td class="fp1-price-cell">${indicatorHtml}${priceStr}</td>
                        <td class="fp1-ask-cell"><div class="fp1-bar-ask" style="width: ${askW}%;"></div><span class="fp1-cell-text">${bookItem.askVol > 0 ? bookItem.askVol.toLocaleString() : ''}</span></td>
                    </tr>
                `;
            });
        }
        domHtml += `</tbody>`; domTableEl.innerHTML = domHtml;

        let fpPricesSet = new Set(Object.keys(priceProfile));
        if (fpPricesSet.size === 0 && currentTradedPriceInt) {
            let baseInt = Math.floor(parseFloat(currentTradedPriceInt));
            for (let i = 4; i >= -4; i--) fpPricesSet.add((baseInt + i).toString());
        }
        let sortedFpPrices = Array.from(fpPricesSet).sort((a, b) => parseInt(b) - parseInt(a));
        let pocIntKey = null, maxVol = -1;
        Object.keys(priceProfile).forEach(p => { if (priceProfile[p].total > maxVol) { maxVol = priceProfile[p].total; pocIntKey = p; } });

        let fpHtml = `<thead><tr><th class="center">Giá</th><th class="right">KL</th><th class="right">Delta</th></tr></thead><tbody>`;
        if (sortedFpPrices.length === 0) {
            fpHtml += `<tr><td colspan="3" style="text-align: center; color: #787b86; padding: 20px;">Đang kết nối T&S...</td></tr>`;
        } else {
            sortedFpPrices.forEach(intKey => {
                let profItem = priceProfile[intKey] || { buy: 0, sell: 0, total: 0 };
                let delta = profItem.buy - profItem.sell;
                let isPoc = (intKey === pocIntKey);
                let isCurrent = (currentTradedPriceInt && intKey === currentTradedPriceInt);
                let isBlock = blockTradeThreshold > 0 && profItem.total >= blockTradeThreshold;

                let rowClass = 'fp1-row-item';
                if (isPoc) rowClass += ' fp1-row-poc';
                if (isBlock) rowClass += ' fp1-row-block';

                let indicatorHtml = isCurrent ? `<span class="fp1-current-indicator">▶</span>` : '';
                let pocBadgeHtml = isPoc ? `<span class="fp1-poc-badge">🔥 POC</span>` : '';
                let blockBadgeHtml = isBlock ? `<span class="fp1-hvn-badge" style="background:#ffc107; color:#000;">⚡ BLOCK</span>` : '';
                let deltaClass = delta > 0 ? 'fp1-delta-pos' : (delta < 0 ? 'fp1-delta-neg' : '');
                let deltaStr = delta > 0 ? `+${delta.toLocaleString()}` : (delta < 0 ? delta.toLocaleString() : '0');

                fpHtml += `<tr class="${rowClass}"><td class="fp1-price-cell">${indicatorHtml}${intKey}${pocBadgeHtml}${blockBadgeHtml}</td><td><b>${profItem.total > 0 ? profItem.total.toLocaleString() : ''}</b></td><td class="${deltaClass}">${profItem.total > 0 ? deltaStr : ''}</td></tr>`;
            });
        }
        fpHtml += `</tbody>`; fpTableEl.innerHTML = fpHtml;

        if (showHistoryPanel) {
            let cumulativeProfile = getCumulativeProfile();
            let cumulativePricesSet = new Set(Object.keys(cumulativeProfile));
            if (cumulativePricesSet.size === 0 && currentTradedPriceInt) {
                let baseInt = Math.floor(parseFloat(currentTradedPriceInt));
                for (let i = 4; i >= -4; i--) cumulativePricesSet.add((baseInt + i).toString());
            }
            let sortedMultiPrices = Array.from(cumulativePricesSet).sort((a, b) => parseInt(b) - parseInt(a));
            let hvnIntKey = null, maxMultiVol = -1;
            Object.keys(cumulativeProfile).forEach(p => { if (cumulativeProfile[p].total > maxMultiVol) { maxMultiVol = cumulativeProfile[p].total; hvnIntKey = p; } });

            let multiHtml = `<thead><tr><th class="center">Giá</th><th class="right">Tổng KL</th><th class="right">Delta ĐT</th></tr></thead><tbody>`;
            sortedMultiPrices.forEach(intKey => {
                let profItem = cumulativeProfile[intKey] || { buy: 0, sell: 0, total: 0 };
                let delta = profItem.buy - profItem.sell;
                let isHvn = (intKey === hvnIntKey);
                let isCurrent = (currentTradedPriceInt && intKey === currentTradedPriceInt);

                let rowClass = 'fp1-row-item';
                if (isHvn) rowClass += ' fp1-row-hvn';
                let indicatorHtml = isCurrent ? `<span class="fp1-current-indicator">▶</span>` : '';
                let hvnBadgeHtml = isHvn ? `<span class="fp1-hvn-badge">⭐ HVN</span>` : '';
                let deltaClass = delta > 0 ? 'fp1-delta-pos' : (delta < 0 ? 'fp1-delta-neg' : '');
                let deltaStr = delta > 0 ? `+${delta.toLocaleString()}` : (delta < 0 ? delta.toLocaleString() : '0');

                multiHtml += `<tr class="${rowClass}"><td class="fp1-price-cell">${indicatorHtml}${intKey}${hvnBadgeHtml}</td><td><b>${profItem.total > 0 ? profItem.total.toLocaleString() : ''}</b></td><td class="${deltaClass}">${profItem.total > 0 ? deltaStr : ''}</td></tr>`;
            });
            multiHtml += `</tbody>`; multiDayTableEl.innerHTML = multiHtml;
        }

        totalEl.innerText = `Tổng KL (Hôm nay): ${totalVolAccumulated.toLocaleString()}`;
        drawCVDChart();
    }

    function addTrade(price, volume, isBuy, timeStr) {
        let priceNum = parseFloat(price);
        if (isNaN(priceNum) || isNaN(volume)) return;

        let intKey = Math.floor(priceNum).toString();
        currentTradedPriceInt = intKey;
        if (!priceProfile[intKey]) priceProfile[intKey] = { buy: 0, sell: 0, total: 0 };

        let isATO = timeStr >= "08:45:00" && timeStr <= "09:00:59";
        let isATC = timeStr >= "14:30:00" && timeStr <= "14:45:59";
        let isPeriodic = isATO || isATC;
        let sessionName = isATO ? "ATO" : (isATC ? "ATC" : "");

        if (isPeriodic) {
            priceProfile[intKey].total += volume;
            totalVolAccumulated += volume;

            let lastCVD = cvdHistory.length > 0 ? cvdHistory[cvdHistory.length - 1].cvd : 0;
            cvdHistory.push({ time: Date.now(), cvd: lastCVD, price: priceNum });
            tradesLog.push({ price: priceNum, volume: volume, isBuy: null, time: Date.now(), type: 'periodic' });
        } else {
            let pStr = priceNum.toFixed(1);
            if (isBuy) tradesSinceLastDOM.askTraded[pStr] = (tradesSinceLastDOM.askTraded[pStr] || 0) + volume;
            else tradesSinceLastDOM.bidTraded[pStr] = (tradesSinceLastDOM.bidTraded[pStr] || 0) + volume;

            if (isBuy) priceProfile[intKey].buy += volume;
            else priceProfile[intKey].sell += volume;

            priceProfile[intKey].total += volume;
            totalVolAccumulated += volume;

            let deltaChange = isBuy ? volume : -volume;
            let lastCVD = cvdHistory.length > 0 ? cvdHistory[cvdHistory.length - 1].cvd : 0;
            let newCVD = lastCVD + deltaChange;
            cvdHistory.push({ time: Date.now(), cvd: newCVD, price: priceNum });
            tradesLog.push({ price: priceNum, volume: volume, isBuy: isBuy, time: Date.now(), type: 'continuous' });
        }

        let activeThreshold = blockTradeThreshold > 0 ? blockTradeThreshold : 20;
        if (volume >= activeThreshold) {
            let tStr = timeStr || new Date().toTimeString().split(' ')[0];
            showBlockTradeToast({
                side: isBuy,
                volume: volume,
                price: priceNum.toFixed(1),
                time: tStr,
                isPeriodic: isPeriodic,
                session: sessionName
            });
        }

        saveData();
        renderWidget();
    }

    function applyLeeReadyAlgorithm(tradePrice, fallbackIsBuy) {
        let bestBid = -Infinity, bestAsk = Infinity;
        for (let pStr in liveOrderBook) {
            let pNum = parseFloat(pStr);
            if (liveOrderBook[pStr].bidVol > 0 && pNum > bestBid) bestBid = pNum;
            if (liveOrderBook[pStr].askVol > 0 && pNum < bestAsk) bestAsk = pNum;
        }

        let isBuy = null;
        if (bestBid !== -Infinity && bestAsk !== Infinity && bestAsk >= bestBid) {
            let midpoint = (bestBid + bestAsk) / 2;
            if (tradePrice > midpoint) isBuy = true;
            else if (tradePrice < midpoint) isBuy = false;
        }

        if (isBuy === null && lastLeeReadyPrice !== null) {
            if (tradePrice > lastLeeReadyPrice) isBuy = true;
            else if (tradePrice < lastLeeReadyPrice) isBuy = false;
            else isBuy = lastLeeReadyDirection;
        }

        if (isBuy === null) isBuy = fallbackIsBuy;
        lastLeeReadyPrice = tradePrice; lastLeeReadyDirection = isBuy;
        return isBuy;
    }

    function scanTable() {
        scanMarketDepthDOM();
        let tsPanel = null;
        const allDivs = document.querySelectorAll('div');
        for (let div of allDivs) {
            if (div.innerText && div.innerText.includes('Thời gian và khối lượng khớp')) { tsPanel = div; break; }
        }

        if (!tsPanel) { statusEl.innerText = "Trạng thái: Đang tìm bảng T&S..."; return; }
        statusEl.innerText = "Trạng thái: Hoạt động mượt mà";

        const rows = tsPanel.querySelectorAll('div, tr, span');
        rows.forEach(row => {
            let text = row.innerText ? row.innerText.trim() : '';
            let timeMatch = text.match(/\d{2}:\d{2}:\d{2}/);

            if (timeMatch && text.match(/\b1\d{3}\.\d\b/)) {
                let signature = text;
                if (!processedSignatures.has(signature)) {
                    processedSignatures.add(signature);

                    let timeStr = timeMatch[0];
                    let parts = text.split(/\s+/);
                    let foundPrice = null, foundVol = 1, htmlIsBuy = true;

                    let htmlContent = row.innerHTML || '';
                    if (htmlContent.includes('color: rgb(242, 54, 69)') || htmlContent.includes('red') || htmlContent.includes('down')) htmlIsBuy = false;
                    else if (htmlContent.includes('color: rgb(8, 153, 129)') || htmlContent.includes('green') || htmlContent.includes('up')) htmlIsBuy = true;

                    for (let i = 0; i < parts.length; i++) {
                        let num = parseFloat(parts[i].replace(/,/g, ''));
                        if (num > 1000 && num < 2500 && parts[i].includes('.')) {
                            foundPrice = num;
                            if (i > 0) {
                                let prevNum = parseInt(parts[i-1].replace(/,/g, ''));
                                if (!isNaN(prevNum) && prevNum > 0 && prevNum < 100000) foundVol = prevNum;
                            }
                            break;
                        }
                    }

                    if (foundPrice) {
                        let finalIsBuy = applyLeeReadyAlgorithm(foundPrice, htmlIsBuy);
                        addTrade(foundPrice, foundVol, finalIsBuy, timeStr);
                    }
                }
            }
        });
    }

    setInterval(scanTable, 500);
    setInterval(() => { hbEl.classList.add('active'); setTimeout(()=>hbEl.classList.remove('active'), 500); }, 1000);
    setTimeout(() => { renderWidget(); }, 1000);
})();
