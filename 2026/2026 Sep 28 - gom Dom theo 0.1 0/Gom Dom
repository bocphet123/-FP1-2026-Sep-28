    const toastContainer = document.createElement('div');
    toastContainer.id = 'block-trade-toast-container';
    document.body.appendChild(toastContainer);

    function showBlockTradeToast({ side, volume, price, time, isPeriodic, session }) {
        let sideText, sideClass, toastClass, headerText;

        if (isPeriodic) {
            sideText = `Khớp lệnh ${session}`;
            sideClass = '';
            toastClass = 'block-trade-toast';
            headerText = `🕒 ${session} MATCH ALERT`;
        } else {
            const isBuy = side;
            sideText = isBuy ? 'Mua chủ động' : 'Bán chủ động';
            sideClass = isBuy ? 'buy-text' : 'sell-text';
            toastClass = isBuy ? 'block-trade-toast' : 'block-trade-toast sell';
            headerText = '⚡ BLOCK TRADE ALERT';
        }

        const toast = document.createElement('div');
        toast.className = toastClass;

        if (isPeriodic) toast.style.borderLeftColor = '#2962ff';

        toast.innerHTML = `
            <div class="toast-header">
                <span>${headerText}</span>
                <span>${time}</span>
            </div>
            <div class="toast-body">
                <span class="${sideClass}">${sideText}:</span> ${isPeriodic ? '' : '+'}${volume.toLocaleString()} lô @ ${price}
            </div>
        `;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 4000);
    }

    const todayStr = new Date().toISOString().slice(0, 10);

    const DAILY_STORAGE_KEY = 'fp1_permanent_storage_daily_final';
    const MULTI_DAY_STORAGE_KEY = 'fp1_multiday_cumulative_final';

    let savedStorage = GM_getValue(DAILY_STORAGE_KEY, null);

    if (!savedStorage) {
        let legacyData = GM_getValue('fp1_permanent_storage_main_v37', null);
        if (legacyData) {
            savedStorage = legacyData;
            GM_setValue(DAILY_STORAGE_KEY, savedStorage);
        }
    }

    if (!savedStorage || savedStorage.date !== todayStr) {
        savedStorage = { date: todayStr, profile: {}, totalVol: 0, cvdData: [], tradesLog: [] };
    }

    let priceProfile = savedStorage.profile || {};
    let totalVolAccumulated = savedStorage.totalVol || 0;
    let cvdHistory = savedStorage.cvdData || [];
    let tradesLog = savedStorage.tradesLog || [];

    let multiDayData = GM_getValue(MULTI_DAY_STORAGE_KEY, null);

    if (!multiDayData) {
        let legacyMulti = GM_getValue('fp1_multiday_cumulative_v37', null);
        if (legacyMulti) {
            multiDayData = legacyMulti;
            GM_setValue(MULTI_DAY_STORAGE_KEY, multiDayData);
        }
    }

    if (!multiDayData) multiDayData = { sessions: {} };
    if (!multiDayData.sessions[todayStr] && Object.keys(priceProfile).length > 0) {
        multiDayData.sessions[todayStr] = JSON.parse(JSON.stringify(priceProfile));
    }

    function getCumulativeProfile() {
        let cumulative = {};
        multiDayData.sessions[todayStr] = JSON.parse(JSON.stringify(priceProfile));
        Object.keys(multiDayData.sessions).forEach(date => {
            let dayProf = multiDayData.sessions[date];
            Object.keys(dayProf).forEach(p => {
                if (!cumulative[p]) cumulative[p] = { buy: 0, sell: 0, total: 0 };
                cumulative[p].buy += (dayProf[p].buy || 0);
                cumulative[p].sell += (dayProf[p].sell || 0);
                cumulative[p].total += (dayProf[p].total || 0);
            });
        });
        return cumulative;
    }

    let processedSignatures = new Set();
    let isMinimized = false;
    let showHistoryPanel = true;
    let showCvdPanel = true;
    let currentTradedPriceInt = null;
    let liveOrderBook = {};
    let prevOrderBook = {};
    let blockTradeThreshold = 0;
    let selectedCvdTf = 'all';

    // State mới: Bước giá gom nhóm DOM (0.1 / 0.5 / 1.0)
    let domGroupingStep = 0.1;

    let lastLeeReadyPrice = null;
    let lastLeeReadyDirection = true;
    let tradesSinceLastDOM = { bidTraded: {}, askTraded: {} };
    let lastDivergenceCheckTime = 0;

    const widgetHTML = `
        <div id="fp1-widget">
            <div id="fp1-header">
                <div class="fp1-title-group">
                    <span id="fp1-heartbeat"></span>
                    <span>📊 FP1 Split DOM & Footprint Pro (Bản Chuẩn - Fixed)</span>
