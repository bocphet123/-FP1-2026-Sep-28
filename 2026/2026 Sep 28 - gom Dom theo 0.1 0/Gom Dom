                                <button class="fp1-tf-btn" data-tf="10m">10m</button>
                                <button class="fp1-tf-btn" data-tf="15m">15m</button>
                                <button class="fp1-tf-btn" data-tf="30m">30m</button>
                                <button class="fp1-tf-btn" data-tf="45m">45m</button>
                                <button class="fp1-tf-btn" data-tf="1h">1h</button>
                                <button class="fp1-tf-btn" data-tf="1d">1d</button>
