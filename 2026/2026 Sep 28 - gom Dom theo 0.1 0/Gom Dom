                    <button class="fp1-btn" id="fp1-reset-multi" title="Reset toàn bộ lịch sử đa phiên" style="color: #f23645;">Reset Multi</button>
                    <button class="fp1-btn" id="fp1-reset" title="Reset dữ liệu hôm nay" style="color: #ff9800;">Reset Ngày</button>
